{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOI DAS experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seed", "device", "cpu_threads", "evaluation_batch_size", "model", "tokenizer", "data", "intervention", "training"],
  "properties": {
    "schema_version": {"const": 1},
    "extends": {"type": "string", "minLength": 1},
    "task": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "device": {"type": "string", "pattern": "^(?:cpu|cuda(?::[0-9]+)?)$"},
    "cpu_threads": {"type": "integer", "minimum": 1},
    "evaluation_batch_size": {"type": "integer", "minimum": 1},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "revision", "local_files_only", "dtype", "attn_implementation"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?:openai-community/)?gpt2(?:-medium|-large|-xl)?$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "local_files_only": {"const": true},
        "dtype": {"const": "float32"},
        "attn_implementation": {"const": "eager"}
      }
    },
    "tokenizer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "revision", "local_files_only"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?:openai-community/)?gpt2(?:-medium|-large|-xl)?$"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "local_files_only": {"const": true}
      }
    },
    "data": {
      "type": "object", "required": ["train"],
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*/[a-z][a-z0-9_]*$"}
    },
    "intervention": {
      "type": "object", "additionalProperties": false,
      "required": ["target_variable", "component", "layer", "location", "rank"],
      "properties": {
        "target_variable": {"const": "position"},
        "component": {"const": "block_output"},
        "layer": {"type": "integer", "minimum": 0},
        "location": {"type": "string", "pattern": "^(?:GOAL_NAME|IO|S1|S2|END|N)(?:[+-][0-9]+)?$"},
        "rank": {"type": "integer", "minimum": 1}
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["epochs", "batch_size", "optimizer", "learning_rate", "betas", "eps", "weight_decay", "schedule", "scheduler"],
      "properties": {
        "epochs": {"type": "integer", "minimum": 1},
        "batch_size": {"type": "integer", "minimum": 1},
        "optimizer": {"const": "Adam"},
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "betas": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}},
        "eps": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0},
        "schedule": {"const": "legacy_per_update_linearlr"},
        "scheduler": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "start_factor", "end_factor", "total_iters", "step_interval"],
          "properties": {
            "name": {"const": "LinearLR"},
            "start_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "end_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "total_iters": {"type": "integer", "minimum": 1},
            "step_interval": {"const": "batch"}
          }
        }
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "aggregate", "tie_break", "evaluate_after_lock"],
      "properties": {
        "metric": {"const": "validation_iia"},
        "aggregate": {"const": "mean_over_seeds"},
        "tie_break": {"const": "lowest_layer"},
        "evaluate_after_lock": {"type": "array", "minItems": 1, "uniqueItems": true,
                                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      }
    },
    "grid": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
      "additionalProperties": {"oneOf": [{"const": "all"}, {"type": "array", "minItems": 1, "uniqueItems": true}]}
    }
  }
}
